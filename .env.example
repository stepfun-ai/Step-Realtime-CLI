# Step Code 环境变量示例。复制为 .env 后填入，或直接 export 到 shell。
# 完整配置（多渠道、多模型、thinking、hooks、MCP）见 ~/.step-code/config.toml 与 docs/configuration.md。

# ── API key（必填其一）──────────────────────────────────────────
# 访问阶跃 Step 系列模型的 key。也可写在 config.toml 的 [providers.<id>] 或 [models.<别名>] 下。
STEP_CODE_API_KEY=

# ── 以下均可选，用于覆盖 config.toml / provider 预设的默认值 ──────
# provider 预设：决定接入协议。可选 stepfun（默认，Anthropic Messages 协议）、
# anthropic、openai（Chat Completions）、openai_responses（Responses，纯对话）。
# STEP_CODE_PROVIDER=stepfun

# 覆盖默认 base_url（未设时用所选 provider 预设的默认地址）。
# anthropic 协议不带 /v1，openai 协议带 /v1，配错会 404。
# STEP_CODE_BASE_URL=https://api.stepfun.com

# 覆盖默认模型（默认 step-3.7-flash）。
# STEP_CODE_MODEL=step-3.7-flash

# ── 进阶 ────────────────────────────────────────────────────────
# 打开调试日志（写入 ~/.step-code/logs）。
# STEP_CODE_DEBUG=1

# 覆盖插件扫描根目录（默认 ~/.step-code/plugins）。
# STEP_CODE_PLUGIN_ROOT=

# 指定 bash 解释器路径（仅 Windows 需要）。bash 工具默认自动探测 Git Bash，
# 装在非标准路径（如便携版、Scoop）探测不到时，把 bash.exe 绝对路径填这里。
# STEP_SHELL_PATH=C:\Program Files\Git\bin\bash.exe
